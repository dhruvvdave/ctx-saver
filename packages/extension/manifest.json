{
  "manifest_version": 3,
  "name": "ctx — context saver",
  "version": "1.0.1",
  "description": "Silently tracks your browser sessions on your own machine so you can resume exactly where you left off.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://localhost:7331/*",
    "http://127.0.0.1:7331/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["privacy-rules.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ctx — context saver"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
